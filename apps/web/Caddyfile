# Static file server for the built SPA (one container per environment, behind the edge Caddy).
{
	admin off
	persist_config off
	auto_https off
}

:8080 {
	root * /srv
	@assets path /assets/*
	handle @assets {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
