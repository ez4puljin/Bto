# Copy to apps/api/.env for local development (gitignored). Never commit real secrets.
NODE_ENV=development
# Local api port (the container uses 3000). 3000 is often taken by other dev servers; the Vite
# proxy of apps/web reads API_PORT from this file.
API_PORT=3300
LOG_LEVEL=debug
# Runtime role "app" and migration role "migrator" (created by `pnpm db:provision`).
DATABASE_URL=postgres://app:app_dev_pw@127.0.0.1:15432/bto_main
MIGRATOR_DATABASE_URL=postgres://migrator:migrator_dev_pw@127.0.0.1:15432/bto_main
DB_POOL_MAX=6
PGBOSS_POOL_MAX=2
WORKER_HEALTH_PORT=3001
# api only (ADR-0027). Development values must start with "dev-" (refused in production); generate real ones with
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=dev-jwt-secret-change-me-0123456789abcdef
AUTH_PEPPER=dev-auth-pepper-change-me-0123456789abcdef
# Secure refresh cookie: true behind HTTPS; false for http://localhost and phones on the LAN
COOKIE_SECURE=false
# Files (ADR-0030): the local driver until the go-live phase; relative to apps/api (= <repo>/.data/storage, gitignored)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=../../.data/storage
# AI assistant (ADR-0045, docs/modules/ai.md), api only: off while LLM_PROVIDER is empty.
# LLM_PROVIDER: openai | anthropic | ollama. LLM_API_KEY is a secret: put it only in this gitignored file,
# never in a commit, a chat message or a log (Ollama needs none).
LLM_PROVIDER=
# an OpenAI model (gpt-6.1-sol is cheaper), a Claude model id, or a local Ollama model name
LLM_MODEL=gpt-6-astra
LLM_API_KEY=
# optional; defaults https://api.openai.com/v1, https://api.anthropic.com/v1, http://127.0.0.1:11434/api
LLM_BASE_URL=
LLM_TIMEOUT_MS=60000
# the assistant's read-only role (created by `pnpm db:provision`) and its own pool
AI_DATABASE_URL=postgres://ai_reader:ai_reader_dev_pw@127.0.0.1:15432/bto_main
AI_POOL_MAX=2
# `pnpm db:provision` only. DigitalOcean: postgres://doadmin:...@host:25060/defaultdb?sslmode=verify-full&sslrootcert=/path/ca.crt
ADMIN_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:15432/postgres
# Jest harness only: creates and drops tugeel_test_* databases; refuses non-local hosts.
TEST_ADMIN_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:15432/postgres
