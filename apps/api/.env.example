# Copy to apps/api/.env for local development (gitignored). Never commit real secrets.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Runtime role "app" and migration role "migrator" (created by `pnpm db:provision`).
DATABASE_URL=postgres://app:app_dev_pw@127.0.0.1:15432/tugeel
MIGRATOR_DATABASE_URL=postgres://migrator:migrator_dev_pw@127.0.0.1:15432/tugeel
DB_POOL_MAX=6
PGBOSS_POOL_MAX=2
WORKER_HEALTH_PORT=3001
# api only (ADR-0027). Development values must start with "dev-" (refused in production); generate real ones with
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=dev-jwt-secret-change-me-0123456789abcdef
AUTH_PEPPER=dev-auth-pepper-change-me-0123456789abcdef
# Secure refresh cookie: true behind HTTPS; false for http://localhost and phones on the LAN
COOKIE_SECURE=false
# `pnpm db:provision` only. DigitalOcean: postgres://doadmin:...@host:25060/defaultdb?sslmode=verify-full&sslrootcert=/path/ca.crt
ADMIN_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:15432/postgres
# Jest harness only: creates and drops tugeel_test_* databases; refuses non-local hosts.
TEST_ADMIN_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:15432/postgres
