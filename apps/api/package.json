{
  "name": "@tugeel/api",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build",
    "start": "node --enable-source-maps dist/main.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker --path tsconfig.worker-dev.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/jest.cjs --selectProjects unit",
    "test:integration": "node scripts/jest.cjs --selectProjects integration --maxWorkers=4",
    "test:integrity": "node scripts/jest.cjs --selectProjects integrity --runInBand",
    "db:provision": "tsx src/db/provision.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx src/db/migrate.ts",
    "openapi:export": "nest build && node dist/openapi/export-openapi.js ../../packages/api-client/openapi.json",
    "user:create-admin": "tsx src/modules/identity/cli/create-admin.ts",
    "catalog:reindex-search": "tsx src/modules/catalog/cli/reindex-search.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@opentelemetry/api": "1.9.1",
    "@tugeel/shared": "workspace:*",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "drizzle-orm": "0.45.4",
    "helmet": "8.3.0",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pg-boss": "12.37.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@nestjs/testing": "12.1.2",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "jest": "30.5.2",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
