# The centre on the store's Ubuntu PC (deploy/store/docker-compose.store.yml, ADR-0186).
# deploy/store/setup.sh writes deploy/store/.env (chmod 600, gitignored) with fresh secrets made
# on the box; nobody types or copies them. This file only names the variables: placeholders, never
# real values (the repository is public). docs/runbooks/store-install.md

# Staff open http://<this PC's LAN address>:STORE_HTTP_PORT (the tills keep the edge's 7400)
STORE_HTTP_PORT=80
# The name the staff app reaches the api under from outside, through the owner's Cloudflare tunnel
# (ADR-0188), e.g. app.example.mn; empty = nothing is answered from outside. The office's web is
# served under it too (ADR-0189).
STORE_PUBLIC_HOST=
# The countries a caller under that name may be in, by Cloudflare's CF-IPCountry: two letters, more
# than one as MN|KR. Everyone else, and a request that did not come through Cloudflare, gets 403.
STORE_PUBLIC_COUNTRIES=MN
# PostgreSQL on the box's loopback only (the seed over an SSH tunnel, psql on the box)
STORE_PG_PORT=15433
# Sizes (ADR-0191). Empty or absent = the defaults of the compose file, made for a 7 GB box:
# PostgreSQL 512MB shared_buffers, 2GB effective cache, 40 connections, 1536m; api pool 6, 1024m;
# worker pool 2, 768m. A PC with more memory sets all of them together, e.g. for 30 GB:
#   STORE_PG_SHARED_BUFFERS=2GB  STORE_PG_EFFECTIVE_CACHE=8GB  STORE_PG_MAX_CONNECTIONS=100
#   STORE_PG_MEMORY=4g  STORE_API_DB_POOL_MAX=20  STORE_API_MEMORY=3g
#   STORE_WORKER_DB_POOL_MAX=4  STORE_WORKER_MEMORY=1g
# max_connections must stay above api pool + 1 + 2 + 2 (AI) + worker pool + 2, with room to spare.
#STORE_PG_SHARED_BUFFERS=
#STORE_PG_EFFECTIVE_CACHE=
#STORE_PG_MAX_CONNECTIONS=
#STORE_PG_MEMORY=
#STORE_API_DB_POOL_MAX=
#STORE_API_MEMORY=
#STORE_WORKER_DB_POOL_MAX=
#STORE_WORKER_MEMORY=
LOG_LEVEL=info

# PostgreSQL superuser of this stack's container: only the one-off `provision` service sees it
POSTGRES_PASSWORD=change-me
# The three roles `provision` creates (hex, they travel inside connection URLs)
APP_DB_PASSWORD=change-me
MIGRATOR_DB_PASSWORD=change-me
AI_DB_PASSWORD=change-me

# api only (ADR-0027): 32+ random characters each, never starting with "dev-"
JWT_SECRET=change-me-change-me-change-me-change-me
AUTH_PEPPER=change-me-change-me-change-me-change-me
# The tills' PIN key (ADR-0063 #6); the edge receives it when it is linked (ADR-0136 #4)
POS_PIN_PEPPER=change-me-change-me-change-me-change-me
# Seals the AI key typed on «Тохиргоо → AI» (ADR-0162): 32 random bytes in base64
AI_KEY_SECRET=change-me

# The AI assistant from the environment instead of the settings screen (optional, ADR-0045)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# Backups (deploy/store/backup.sh, run nightly as root by the bto-backup timer)
# Where the dumps and the file mirror are kept on this PC, and for how many days
BACKUP_DIR=/var/backups/bto
BACKUP_KEEP_DAYS=14
# A USB disk mounted here gets a copy every night, kept longer; not mounted = that copy is skipped
BACKUP_USB_DIR=/mnt/bto-backup
BACKUP_USB_KEEP_DAYS=90
