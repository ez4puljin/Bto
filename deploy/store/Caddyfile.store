# The centre on the store's Ubuntu PC (ADR-0186): the admin's pages and /api on one port of the
# store's LAN, plain HTTP. No certificate, no HSTS: the external server brings HTTPS (ADR-0026).
# ADR-0188, ADR-0189: the staff app and the office's web are also reached from outside, under the name
# STORE_PUBLIC_HOST, through the owner's Cloudflare tunnel (HTTPS ends at Cloudflare; `cloudflared`
# on this PC calls this port), and only from the countries of STORE_PUBLIC_COUNTRIES.
{
	admin off
	persist_config off
	auto_https off
	servers {
		# Only the hop from this PC itself (cloudflared and the edge, which arrive through Docker's
		# bridge, 172.16.0.0/12) may say who the caller is in X-Forwarded-For; the api's sign-in limits
		# count by that address. The store's LAN is not in this range, so a LAN client cannot forge one.
		trusted_proxies static 172.16.0.0/12
		trusted_proxies_strict
	}
}

:80 {
	# The outside name (ADR-0189). Unset, the name is one no request carries.
	# Only callers Cloudflare places in an allowed country are answered: the header is Cloudflare's
	# (`CF-IPCountry`, two letters; XX unknown, T1 Tor), a list is written MN|KR. A request without
	# the header did not come through Cloudflare and is refused too.
	@outsideForeign {
		host {$STORE_PUBLIC_HOST:outside.invalid}
		not header_regexp CF-IPCountry ^({$STORE_PUBLIC_COUNTRIES:MN})$
	}
	handle @outsideForeign {
		respond "Not available in your country." 403
	}

	# Plain HTTP at Cloudflare's edge is sent to HTTPS: the web's sign-in cookie is `Secure` there.
	@outsideHttp {
		host {$STORE_PUBLIC_HOST:outside.invalid}
		header X-Forwarded-Proto http
	}
	handle @outsideHttp {
		redir https://{host}{uri} 308
	}

	# The apps' live stock streams (ADR-0173 #4, text/event-stream) are never compressed: an encoder
	# buffers, and every event must reach the phone at once.
	@compressible not path */stock/live
	encode @compressible zstd gzip
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
		-Server
	}

	@backend path /api/* /health /health/*
	handle @backend {
		reverse_proxy api:3000 {
			lb_try_duration 10s
		}
	}

	@assets path /assets/*
	handle @assets {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		# 'wasm-unsafe-eval': the camera barcode scanner compiles our self-hosted ZXing .wasm (ADR-0031).
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' https://tiles.openfreemap.org; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
