# Placeholders only — never commit real values (this repository is public).
# Production: copy to /opt/tugeel/.env; staging: /opt/tugeel/.env.staging (chmod 600).
# Local test runs: deploy/.env and deploy/.env.staging (gitignored).

# image tags (git sha), set by the deploy job
API_TAG=sha-0000000
WEB_TAG=sha-0000000

# edge Caddy (prod compose file only); local runs use http://admin.localhost etc.
ADMIN_HOST=admin.example.mn
API_HOST=api.example.mn
STAGING_HOST=staging.example.mn
ACME_EMAIL=owner@example.mn
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443

# staging PostgreSQL container superuser (staging file only)
POSTGRES_PASSWORD=change-me

# api and worker (apps/api/src/common/config/env.schema.ts); DB_POOL_MAX/PGBOSS_POOL_MAX are set in compose
NODE_ENV=production
LOG_LEVEL=info
DATABASE_URL=postgres://app:change-me@db.example:25060/tugeel?sslmode=require
MIGRATOR_DATABASE_URL=postgres://migrator:change-me@db.example:25060/tugeel?sslmode=require
# api only (ADR-0027): at least 32 random characters each, never starting with "dev-"; COOKIE_SECURE stays true behind Caddy
JWT_SECRET=change-me
AUTH_PEPPER=change-me
COOKIE_SECURE=true
# files (ADR-0030): STORAGE_DRIVER=spaces refuses to start until the go-live phase builds that driver
# (ADR-0026); the rehearsal stacks keep files in the container's /tmp, which a restart empties
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/tmp/tugeel-storage

# one-off `node dist/db/provision.js` only (staging file; production: type it at the prompt, never store it)
# ADMIN_DATABASE_URL=postgres://postgres:change-me@postgres-staging:5432/postgres
