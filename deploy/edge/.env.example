# The store edge (deploy/edge/docker-compose.edge.yml, ADR-0067). Copy to deploy/edge/.env
# (gitignored) and fill in; never commit the filled file.

# The tills open http://<this PC's LAN address>:KIOSK_PORT
KIOSK_PORT=7400
# The edge's own PostgreSQL (inside the stack only)
EDGE_DB_PASSWORD=change-me
# The centre the edge replays to; the owner's dev api by default
CENTRAL_API_URL=http://host.docker.internal:3300
# «Супермаркет → Касс → Шинэ токен» of this store's edge server: tgs_<id>_<secret>
EDGE_NODE_TOKEN=
# 32+ random characters: signs the cashiers' 12-hour sessions
EDGE_JWT_SECRET=
# The same value as the centre's POS_PIN_PEPPER (or its AUTH_PEPPER until that is set)
POS_PIN_PEPPER=
