# The kiosk on the store edge (ADR-0067): pos.html and its assets, and /edge/* to the edge.
{
	admin off
	persist_config off
	auto_https off
}

:7400 {
	encode zstd gzip
	handle /edge/* {
		reverse_proxy edge:3400
	}
	# The admin's page is not served here: the tills see the kiosk only.
	redir /index.html / 302
	@assets path /assets/*
	handle @assets {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /pos.html
		file_server {
			index pos.html
		}
	}
}
