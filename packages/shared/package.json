{
  "name": "@tugeel/shared",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@tugeel/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./money": {
      "@tugeel/source": "./src/money/index.ts",
      "types": "./dist/money/index.d.ts",
      "default": "./dist/money/index.js"
    },
    "./errors": {
      "@tugeel/source": "./src/errors/index.ts",
      "types": "./dist/errors/index.d.ts",
      "default": "./dist/errors/index.js"
    },
    "./auth": {
      "@tugeel/source": "./src/auth/index.ts",
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./settings": {
      "@tugeel/source": "./src/settings/index.ts",
      "types": "./dist/settings/index.d.ts",
      "default": "./dist/settings/index.js"
    },
    "./time": {
      "@tugeel/source": "./src/time/index.ts",
      "types": "./dist/time/index.d.ts",
      "default": "./dist/time/index.js"
    },
    "./phone": {
      "@tugeel/source": "./src/phone/index.ts",
      "types": "./dist/phone/index.d.ts",
      "default": "./dist/phone/index.js"
    },
    "./text": {
      "@tugeel/source": "./src/text/index.ts",
      "types": "./dist/text/index.d.ts",
      "default": "./dist/text/index.js"
    },
    "./gtin": {
      "@tugeel/source": "./src/gtin/index.ts",
      "types": "./dist/gtin/index.d.ts",
      "default": "./dist/gtin/index.js"
    },
    "./units": {
      "@tugeel/source": "./src/units/index.ts",
      "types": "./dist/units/index.d.ts",
      "default": "./dist/units/index.js"
    },
    "./files": {
      "@tugeel/source": "./src/files/index.ts",
      "types": "./dist/files/index.d.ts",
      "default": "./dist/files/index.js"
    },
    "./taxpayer": {
      "@tugeel/source": "./src/taxpayer/index.ts",
      "types": "./dist/taxpayer/index.d.ts",
      "default": "./dist/taxpayer/index.js"
    },
    "./geo": {
      "@tugeel/source": "./src/geo/index.ts",
      "types": "./dist/geo/index.d.ts",
      "default": "./dist/geo/index.js"
    },
    "./i18n/*.json": "./i18n/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "i18n"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "dayjs": "catalog:",
    "decimal.js": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
