  "info": {
    "title": "Tugeel API",
    "description": "",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "type": "string",
            "description": "ok only when every component is up"
          },
          "db": {
            "enum": [
              "up",
              "down"
            ],
            "type": "string"
          },
          "pgboss": {
            "enum": [
              "up",
              "down"
            ],
            "type": "string"
          },
          "version": {
            "type": "string",
            "example": "sha-0a1b2c3"
          }
        },
        "required": [
          "status",
          "db",
          "pgboss",
          "version"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "example": "bat.erdene"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "format": "password"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "Permission": {
        "type": "string",
        "enum": [
          "identity.users.read",
          "identity.users.manage",
          "identity.roles.manage",
          "identity.org.manage",
          "identity.settings.read",
          "identity.settings.manage",
          "identity.audit.read"
        ]
      },
      "RoleRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "code": {
            "type": "string",
            "nullable": true,
            "description": "System roles only"
          },
          "name": {
            "type": "string",
            "nullable": true,
            "description": "Custom roles only"
          },
          "isSystem": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "code",
          "name",
          "isSystem"
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "username": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Permission"
            }
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoleRef"
            }
          },
          "writableWarehouseIds": {
            "nullable": true,
            "description": "Warehouses this user may write documents for; null = every warehouse",
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "sessionExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "username",
          "fullName",
          "permissions",
          "roles",
          "writableWarehouseIds",
          "sessionExpiresAt"
        ]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "sessionExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "me": {
            "$ref": "#/components/schemas/Me"
          }
        },
        "required": [
          "accessToken",
          "accessTokenExpiresAt",
          "sessionExpiresAt",
          "me"
        ]
      },
      "AccessToken": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "sessionExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "accessToken",
          "accessTokenExpiresAt",
          "sessionExpiresAt"
        ]
      },
      "PasswordChangeRequest": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "maxLength": 256,
            "format": "password"
          },
          "newPassword": {
            "type": "string",
            "maxLength": 128,
            "format": "password"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "PasswordSetupRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "example": "bat.erdene"
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "description": "One-time code issued by an admin, e.g. 7KQ2M-X9D4F"
          },
          "newPassword": {
            "type": "string",
            "maxLength": 128,
            "format": "password"
          }
        },
        "required": [
          "username",
          "code",
          "newPassword"
        ]
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "BAD_REQUEST",
          "VALIDATION_FAILED",
          "UNAUTHORIZED",
          "FORBIDDEN",
          "NOT_FOUND",
          "METHOD_NOT_ALLOWED",
          "CONFLICT",
          "PAYLOAD_TOO_LARGE",
          "UNSUPPORTED_MEDIA_TYPE",
          "TOO_MANY_REQUESTS",
          "INTERNAL_ERROR",
          "SERVICE_UNAVAILABLE",
          "IDEMPOTENCY_KEY_REQUIRED",
          "IDEMPOTENCY_KEY_REUSED",
          "IDEMPOTENCY_KEY_IN_PROGRESS",
          "DUPLICATE_VALUE",
          "INVALID_CREDENTIALS",
          "ACCOUNT_LOCKED",
          "ACCOUNT_DISABLED",
          "SESSION_EXPIRED",
          "PASSWORD_CODE_INVALID",
          "PASSWORD_TOO_WEAK",
          "CURRENT_PASSWORD_INCORRECT",
          "LAST_ADMIN",
          "SELF_EDIT_FORBIDDEN",
          "ROLE_SYSTEM_READONLY",
          "ROLE_IN_USE",
          "WAREHOUSE_KIND_NOT_ALLOWED",
          "SETTING_NOT_EDITABLE",
          "SETTING_MISSING",
          "DOC_ALREADY_POSTED",
          "ALREADY_POSTED",
          "STOCK_INSUFFICIENT",
          "BIN_LOCKED_FOR_COUNT",
          "UNIT_SUPERSEDED",
          "PRICE_MISSING",
          "DISCOUNT_OVER_CAP",
          "CREDIT_BLOCKED",
          "CREDIT_NEEDS_APPROVAL",
          "ORDER_STATE_INVALID",
          "EBARIMT_ATTRIBUTES_MISSING",
          "TIN_PENDING",
          "EBARIMT_INDETERMINATE",
          "PAYMENT_NOT_VERIFIED"
        ]
      },
      "ProblemFieldError": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "example": "quantity"
          },
          "constraint": {
            "type": "string",
            "example": "isPositive"
          },
          "message": {
            "type": "string",
            "example": "quantity must be a positive number"
          }
        },
        "required": [
          "path",
          "constraint",
          "message"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "https://tugeel.local/errors/NOT_FOUND"
          },
          "title": {
            "type": "string",
            "example": "Not found"
          },
          "status": {
            "type": "number",
            "example": 404
          },
          "code": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ErrorCode"
              }
            ]
          },
          "detail": {
            "type": "string",
            "description": "English detail for logs; clients show text chosen by code."
          },
          "instance": {
            "type": "string",
            "example": "/api/v1/bin-moves/4412"
          },
          "requestId": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProblemFieldError"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ]
      }
    }
  }
}
