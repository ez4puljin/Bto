  "info": {
    "title": "Tugeel API",
    "description": "",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "type": "string",
            "description": "ok only when every component is up"
          },
          "db": {
            "enum": [
              "up",
              "down"
            ],
            "type": "string"
          },
          "pgboss": {
            "enum": [
              "up",
              "down"
            ],
            "type": "string"
          },
          "version": {
            "type": "string",
            "example": "sha-0a1b2c3"
          }
        },
        "required": [
          "status",
          "db",
          "pgboss",
          "version"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "example": "bat.erdene"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "format": "password"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "Permission": {
        "type": "string",
        "enum": [
          "identity.users.read",
          "identity.users.manage",
          "identity.roles.manage",
          "identity.org.manage",
          "identity.settings.read",
          "identity.settings.manage",
          "identity.audit.read"
        ]
      },
      "RoleRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "code": {
            "type": "string",
            "nullable": true,
            "description": "System roles only"
          },
          "name": {
            "type": "string",
            "nullable": true,
            "description": "Custom roles only"
          },
          "isSystem": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "code",
          "name",
          "isSystem"
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "username": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Permission"
            }
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoleRef"
            }
          },
          "writableWarehouseIds": {
            "nullable": true,
            "description": "Warehouses this user may write documents for; null = every warehouse",
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "sessionExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "username",
          "fullName",
          "permissions",
          "roles",
          "writableWarehouseIds",
          "sessionExpiresAt"
        ]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "sessionExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "me": {
            "$ref": "#/components/schemas/Me"
          }
        },
        "required": [
          "accessToken",
          "accessTokenExpiresAt",
          "sessionExpiresAt",
          "me"
        ]
      },
      "AccessToken": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "sessionExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "accessToken",
          "accessTokenExpiresAt",
          "sessionExpiresAt"
        ]
      },
      "PasswordChangeRequest": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "maxLength": 256,
            "format": "password"
          },
          "newPassword": {
            "type": "string",
            "maxLength": 128,
            "format": "password"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "PasswordSetupRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "example": "bat.erdene"
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "description": "One-time code issued by an admin, e.g. 7KQ2M-X9D4F"
          },
          "newPassword": {
            "type": "string",
            "maxLength": 128,
            "format": "password"
          }
        },
        "required": [
          "username",
          "code",
          "newPassword"
        ]
      },
      "UserSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "username": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ACTIVE",
              "DISABLED"
            ],
            "type": "string"
          },
          "roleIds": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "lastLoginAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "lockedUntil": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "username",
          "fullName",
          "status",
          "roleIds",
          "lastLoginAt",
          "lockedUntil"
        ]
      },
      "UserPage": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserSummary"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "data",
          "nextCursor"
        ]
      },
      "UserScopes": {
        "type": "object",
        "properties": {
          "warehouseIds": {
            "maxItems": 100,
            "description": "Warehouses the user may write documents for",
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 1
            }
          },
          "branchIds": {
            "maxItems": 100,
            "description": "Branches whose warehouses the user may write for",
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 1
            }
          }
        },
        "required": [
          "warehouseIds",
          "branchIds"
        ]
      },
      "UserDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "username": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ACTIVE",
              "DISABLED"
            ],
            "type": "string"
          },
          "roleIds": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "lastLoginAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "lockedUntil": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "passwordSet": {
            "type": "boolean",
            "description": "False until the user redeems a one-time code"
          },
          "failedLoginCount": {
            "type": "number"
          },
          "scopes": {
            "$ref": "#/components/schemas/UserScopes"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "username",
          "fullName",
          "status",
          "roleIds",
          "lastLoginAt",
          "lockedUntil",
          "phone",
          "passwordSet",
          "failedLoginCount",
          "scopes",
          "createdAt",
          "updatedAt"
        ]
      },
      "UserCreateRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 64,
            "example": "bat.erdene",
            "pattern": "^[a-z0-9][a-z0-9._-]{2,31}$"
          },
          "fullName": {
            "type": "string",
            "maxLength": 100,
            "example": "Батын Эрдэнэ"
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "maxLength": 32,
            "example": "99112233"
          },
          "roleIds": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 1
            }
          },
          "scopes": {
            "$ref": "#/components/schemas/UserScopes"
          }
        },
        "required": [
          "username",
          "fullName",
          "roleIds"
        ]
      },
      "UserUpdateRequest": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "maxLength": 100
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "maxLength": 32
          },
          "status": {
            "enum": [
              "ACTIVE",
              "DISABLED"
            ],
            "type": "string"
          },
          "roleIds": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 1
            }
          },
          "scopes": {
            "$ref": "#/components/schemas/UserScopes"
          }
        }
      },
      "PasswordCode": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "7KQ2M-X9D4F",
            "description": "Shown once; give it to the user"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "code",
          "expiresAt"
        ]
      },
      "Session": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastUsedAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "userAgent": {
            "type": "string",
            "nullable": true
          },
          "ip": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "createdAt",
          "lastUsedAt",
          "expiresAt",
          "userAgent",
          "ip"
        ]
      },
      "PermissionInfo": {
        "type": "object",
        "properties": {
          "code": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Permission"
              }
            ]
          },
          "assignable": {
            "type": "boolean",
            "description": "False for codes reserved for the ADMIN role"
          }
        },
        "required": [
          "code",
          "assignable"
        ]
      },
      "Role": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "code": {
            "type": "string",
            "nullable": true,
            "description": "System roles only"
          },
          "name": {
            "type": "string",
            "nullable": true,
            "description": "Custom roles only"
          },
          "isSystem": {
            "type": "boolean"
          },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Permission"
            }
          },
          "userCount": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "code",
          "name",
          "isSystem",
          "permissions",
          "userCount"
        ]
      },
      "RoleCreateRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 60,
            "example": "Агуулахын ахлах"
          },
          "permissions": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "$ref": "#/components/schemas/Permission"
            }
          }
        },
        "required": [
          "name",
          "permissions"
        ]
      },
      "RoleUpdateRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 60
          },
          "permissions": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "$ref": "#/components/schemas/Permission"
            }
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "BAD_REQUEST",
          "VALIDATION_FAILED",
          "UNAUTHORIZED",
          "FORBIDDEN",
          "NOT_FOUND",
          "METHOD_NOT_ALLOWED",
          "CONFLICT",
          "PAYLOAD_TOO_LARGE",
          "UNSUPPORTED_MEDIA_TYPE",
          "TOO_MANY_REQUESTS",
          "INTERNAL_ERROR",
          "SERVICE_UNAVAILABLE",
          "IDEMPOTENCY_KEY_REQUIRED",
          "IDEMPOTENCY_KEY_REUSED",
          "IDEMPOTENCY_KEY_IN_PROGRESS",
          "DUPLICATE_VALUE",
          "INVALID_CREDENTIALS",
          "ACCOUNT_LOCKED",
          "ACCOUNT_DISABLED",
          "SESSION_EXPIRED",
          "PASSWORD_CODE_INVALID",
          "PASSWORD_TOO_WEAK",
          "CURRENT_PASSWORD_INCORRECT",
          "LAST_ADMIN",
          "SELF_EDIT_FORBIDDEN",
          "ROLE_SYSTEM_READONLY",
          "ROLE_IN_USE",
          "WAREHOUSE_KIND_NOT_ALLOWED",
          "SETTING_NOT_EDITABLE",
          "SETTING_MISSING",
          "DOC_ALREADY_POSTED",
          "ALREADY_POSTED",
          "STOCK_INSUFFICIENT",
          "BIN_LOCKED_FOR_COUNT",
          "UNIT_SUPERSEDED",
          "PRICE_MISSING",
          "DISCOUNT_OVER_CAP",
          "CREDIT_BLOCKED",
          "CREDIT_NEEDS_APPROVAL",
          "ORDER_STATE_INVALID",
          "EBARIMT_ATTRIBUTES_MISSING",
          "TIN_PENDING",
          "EBARIMT_INDETERMINATE",
          "PAYMENT_NOT_VERIFIED"
        ]
      },
      "ProblemFieldError": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "example": "quantity"
          },
          "constraint": {
            "type": "string",
            "example": "isPositive"
          },
          "message": {
            "type": "string",
            "example": "quantity must be a positive number"
          }
        },
        "required": [
          "path",
          "constraint",
          "message"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "https://tugeel.local/errors/NOT_FOUND"
          },
          "title": {
            "type": "string",
            "example": "Not found"
          },
          "status": {
            "type": "number",
            "example": 404
          },
          "code": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ErrorCode"
              }
            ]
          },
          "detail": {
            "type": "string",
            "description": "English detail for logs; clients show text chosen by code."
          },
          "instance": {
            "type": "string",
            "example": "/api/v1/bin-moves/4412"
          },
          "requestId": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProblemFieldError"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ]
      }
    }
  }
}
